# Copy this file to .env and fill it in:  cp .env.example .env
# Never commit .env to GitHub (it's in .gitignore).

# --- Claude ---
# Get a key at https://console.anthropic.com  (also set a monthly spend limit there!)
ANTHROPIC_API_KEY=
# Set to 1 to test everything with a fake Claude (no key needed, no cost)
MOCK_CLAUDE=0

# Model for planning and pixel art (quality matters here) and its price per million tokens (USD)
PLAN_MODEL=claude-sonnet-5-5
PLAN_PRICE_IN=2.00
PLAN_PRICE_OUT=10.00
# Model for chatting with visitors (cheap and fast)
CHAT_MODEL=claude-haiku-5-5
CHAT_PRICE_IN=0.10
CHAT_PRICE_OUT=0.50

# --- Finn's routine ---
# Minutes between creative turns
TURN_INTERVAL_MINUTES=60
# Review and redraw drafts before building (better art, roughly doubles cost per turn)
CRITIQUE=1
# Finn sleeps between these hours (local time). Set both the same to never sleep.
SLEEP_START_HOUR=23
SLEEP_END_HOUR=7
# Your time zone, for sleep hours and the daily budget reset
TZ=Europe/London
START_PAUSED=0

# --- Limits ---
# Finn stops thinking (turns and chat) once he has spent this much today, in USD
DAILY_BUDGET_USD=1.50
CHAT_PER_VISITOR_PER_10_MIN=5
CHAT_PER_VISITOR_PER_DAY=30
CHAT_GLOBAL_PER_HOUR=120

# --- Tennis balls ---
# Most balls that can be lying around at once, and how many each visitor may hide per day
BALLS_MAX_IN_WORLD=5
BALLS_PER_VISITOR_PER_DAY=1

# --- Admin ---
# A long random password for the admin controls. Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# --- Cloudflare Tunnel (only needed to go public) ---
TUNNEL_TOKEN=

# Snapshots of the world to keep (one per turn) for rollback
KEEP_SNAPSHOTS=72
